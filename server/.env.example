NODE_ENV=development
PORT=4000
HEALTH_CHECK_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:5173
MONGO_URI=mongodb://mongodb:change-me@localhost:27017/absliderdb?authSource=admin
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
GEMINI_API_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
# Production: public HTTPS origin used in presigned download URLs.
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=miniouser
MINIO_SECRET_KEY=change-me

# Production bắt buộc email riêng và mật khẩu mạnh; không dùng giá trị mặc định.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin ABSlider
ADMIN_CREDIT_BALANCE=1000

RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENABLE_EMAIL_VERIFICATION=true
