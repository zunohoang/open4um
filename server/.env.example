NODE_ENV=development
PORT=4000
HEALTH_CHECK_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:5173
MONGO_URI=mongodb://mongodb:change-me@localhost:27017/absliderdb?authSource=admin
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
GEMINI_API_KEY=
# Tùy chọn proxy (mặc định để trống sẽ kết nối thẳng đến Google Gemini):
# GEMINI_BASE_URL=https://api.shopaikey.com
# GEMINI_MODEL=gemini-2.0-flash
# Đổi AI bằng tên model: bắt đầu bằng claude- thì gọi Claude (dùng chung key và base URL ở trên), còn lại gọi Gemini.
# GEMINI_MODEL=claude-opus-5-5
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# App timeout must stay below the API gateway timeout (180 seconds).
AI_REQUEST_TIMEOUT_MS=150000
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
# Production: public HTTPS origin used in presigned download URLs.
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=miniouser
MINIO_SECRET_KEY=change-me

# Production bắt buộc email riêng và mật khẩu mạnh; không dùng giá trị mặc định.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin ABSlider
ADMIN_CREDIT_BALANCE=1000

RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENABLE_EMAIL_VERIFICATION=true
