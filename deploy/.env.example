# Use a distinct Compose project for each environment:
# docker compose --project-name abslider-production --env-file /opt/abslider/shared/production.env -f deploy/compose.yml ...
# docker compose --project-name abslider-develop --env-file /opt/abslider/shared/develop.env -f deploy/compose.yml ...

ABSLIDER_SERVER_IMAGE=abslider-server:local
ABSLIDER_CLIENT_IMAGE=abslider-client:local
RELEASE_SHA=0123456789abcdef0123456789abcdef01234567
RELEASE_ENVIRONMENT=production

FRONTEND_HOST_PORT=4100
BACKEND_HOST_PORT=4101
MINIO_HOST_PORT=4102

CORS_ALLOWED_ORIGINS=https://slides.sbltcup.dev,https://slides-cup.sbltcup.dev
MINIO_PUBLIC_ENDPOINT=https://slides-media.sbltcup.dev

MONGO_DATABASE=abslider
MONGO_USER=abslider-root
MONGO_PASSWORD=change-me
# URL-encode reserved characters in MONGO_PASSWORD when constructing this URI.
MONGO_URI=mongodb://abslider-root:change-me@mongo:27017/abslider?authSource=admin

JWT_SECRET=change-me-with-at-least-16-characters
GEMINI_API_KEY=change-me
MINIO_USER=abslider-minio
MINIO_PASSWORD=change-me-with-at-least-8-characters

ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe!With12Characters
ADMIN_NAME=Admin ABSlider
ADMIN_CREDIT_BALANCE=1000

RESEND_API_KEY=change-me
RESEND_FROM_EMAIL=ABSlider <noreply@example.com>
ENABLE_EMAIL_VERIFICATION=true

HEALTH_CHECK_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

MONGO_MEMORY_LIMIT=640m
REDIS_MEMORY_LIMIT=160m
MINIO_MEMORY_LIMIT=384m
SERVER_MEMORY_LIMIT=512m
CLIENT_MEMORY_LIMIT=128m
