# Install as /etc/abslider-backup/backup.env with root:root mode 0600.
# This file contains no Azure key or SAS token. Azure authentication uses the
# VM system-assigned Managed Identity.
AZURE_ACCOUNT_NAME=absliderbackupduc1604
RESTIC_REPOSITORY=azure:abslider-restic:/production
RESTIC_PASSWORD_FILE=/etc/abslider-backup/restic-password
ABSLIDER_BACKUP_HOST=abslider-production-01
DOCKER_HOST=unix:///run/user/1001/docker.sock
