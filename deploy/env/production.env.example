# Copy to /opt/abslider/shared/production.env and replace every CHANGE_ME value.
# Production must not reuse any Development credential or volume.

FRONTEND_HOST_PORT=4100
BACKEND_HOST_PORT=4101
MINIO_HOST_PORT=4102

CORS_ALLOWED_ORIGINS=https://slides.sbltcup.dev,https://slides-cup.sbltcup.dev
MINIO_PUBLIC_ENDPOINT=https://slides-media.sbltcup.dev

MONGO_DATABASE=abslider_production
MONGO_USER=abslider-production-root
MONGO_PASSWORD=CHANGE_ME_PRODUCTION_MONGO_PASSWORD
# URL-encode reserved characters from MONGO_PASSWORD in MONGO_URI.
MONGO_URI=mongodb://abslider-production-root:CHANGE_ME_PRODUCTION_MONGO_PASSWORD@mongo:27017/abslider_production?authSource=admin

JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET_AT_LEAST_32_CHARACTERS
GEMINI_API_KEY=CHANGE_ME_PRODUCTION_GEMINI_API_KEY

MINIO_USER=abslider-production-minio
MINIO_PASSWORD=CHANGE_ME_PRODUCTION_MINIO_PASSWORD

ADMIN_EMAIL=CHANGE_ME_PRODUCTION_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_PRODUCTION_ADMIN_PASSWORD
ADMIN_NAME=ABSlider Production Admin
ADMIN_CREDIT_BALANCE=1000

RESEND_API_KEY=CHANGE_ME_PRODUCTION_RESEND_API_KEY
RESEND_FROM_EMAIL=ABSlider <noreply@example.com>
ENABLE_EMAIL_VERIFICATION=true

HEALTH_CHECK_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

MONGO_MEMORY_LIMIT=640m
REDIS_MEMORY_LIMIT=160m
MINIO_MEMORY_LIMIT=384m
SERVER_MEMORY_LIMIT=512m
CLIENT_MEMORY_LIMIT=128m
