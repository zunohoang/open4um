{
  "info": {
    "name": "ABSlider - AI outline (3 scenarios)",
    "description": "Default small suite: valid outline, empty prompt rejection, unauthenticated rejection. One disposable user, one successful-provider attempt, no retries. Setup/readback/cleanup requests are supporting evidence, not extra feature scenarios. Never run against production. Use the Python runner for journaled cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AI outline - three scenarios",
      "item": [
        {
          "name": "Setup - one disposable QA user",
          "item": [
            {
              "name": "API-901 Verify development release",
              "id": "e3fe291d4c83ee2970b5c1a2c4edae97",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/version",
                "header": [],
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "\nif (pm.environment.get('managedRun') !== 'true') {\n  if (pm.environment.get('runId') && pm.environment.get('runComplete') !== 'true') { pm.execution.skipRequest(); pm.execution.setNextRequest(null); throw new Error('Recover the unfinished fixture run first'); }\n  pm.environment.set('runId', pm.variables.replaceIn('{{$guid}}').replace(/-/g,''));\n}\npm.environment.set('runComplete','false');\npm.environment.set('fixturePassword','Qa9!'+pm.variables.replaceIn('{{$guid}}'));\npm.environment.set('userAEmail','qa-'+pm.environment.get('runId')+'-a@example.com');\nfor (const key of ['userAId','userAToken','userARefresh','aiLectureId','expectedBalance','generatedOutline']) pm.environment.unset(key);\n"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Exact HTTP status\", () => { pm.expect(pm.response.code).to.eql(200); });",
                      "let j; try { j = pm.response.json(); } catch (_) { j = {}; } const d = j.data;",
                      "pm.test(\"Success envelope\", () => { pm.expect(j.success).to.eql(true); });",
                      "if (pm.response.code === 200) { pm.test(\"Develop environment\", () => { pm.expect(d.release.environment).to.eql('develop'); });if(d.release.environment!=='develop'){pm.execution.setNextRequest(null);throw new Error('Development release required');} }",
                      "if (pm.response.code !== 200 || j.success !== true) pm.execution.setNextRequest(null);"
                    ]
                  }
                }
              ]
            },
