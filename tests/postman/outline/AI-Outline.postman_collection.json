                      "pm.test(\"Success envelope\", () => { pm.expect(j.success).to.eql(true); });",
                      "if (pm.response.code === 201) { pm.test(\"Exact QA email\", () => { pm.expect(d.email).to.eql(pm.environment.get(\"userAEmail\")); });pm.test(\"Fixture role\", () => { pm.expect(d.role).to.eql('user'); });pm.test(\"Starting balance\", () => { pm.expect(d.creditBalance).to.eql(Number(pm.environment.get(\"fixtureBalance\"))); });pm.environment.set(\"userAId\", d._id); }",
                      "if (pm.response.code !== 201 || j.success !== true) pm.execution.setNextRequest(null);"
                    ]
                  }
                }
              ]
