                      "let j; try { j = pm.response.json(); } catch (_) { j = {}; } const d = j.data;",
                      "pm.test(\"Success envelope\", () => { pm.expect(j.success).to.eql(true); });",
                      "if (pm.response.code === 200) { pm.test(\"Admin role\", () => { pm.expect(d.user.role).to.eql('admin'); });if(d.user.role!=='admin'){pm.execution.setNextRequest(null);throw new Error('QA Admin required');}pm.environment.set(\"adminToken\", d.accessToken);pm.environment.set(\"adminRefresh\", d.refreshToken); }",
