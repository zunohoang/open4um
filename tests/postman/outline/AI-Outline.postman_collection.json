                      "let j; try { j = pm.response.json(); } catch (_) { j = {}; } const d = j.data;",
                      "pm.test(\"Success envelope\", () => { pm.expect(j.success).to.eql(true); });",
                      "if (pm.response.code === 200) { pm.test(\"Positive integer outline price\", () => { pm.expect(Number.isSafeInteger(d.pricePerOutline) && d.pricePerOutline>0).to.eql(true); });if(!Number.isSafeInteger(d.pricePerOutline)||d.pricePerOutline<=0){pm.execution.setNextRequest(null);throw new Error('Invalid outline price');}pm.environment.set(\"outlinePrice\", d.pricePerOutline);pm.environment.set(\"fixtureBalance\", d.pricePerOutline + 10); }",
                      "if (pm.response.code !== 200 || j.success !== true) pm.execution.setNextRequest(null);"
                    ]
                  }
                }
              ]
