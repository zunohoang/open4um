        {
          "name": "Scenario 1 - real outline generation",
          "item": [
            {
              "name": "API-909 AI-OUTLINE-01 Generate a real structured outline",
              "id": "e69d4c20cbe4b1708015c30bf4cf01bb",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/lectures/generate-outline",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{userAToken}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"prompt\": \"QA-{{runId}}: Create an introductory lesson outline explaining addition of natural numbers with examples 2 + 3 = 5 and 4 + 1 = 5.\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      ""
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Exact HTTP status\", () => { pm.expect(pm.response.code).to.eql(200); });",
                      "let j; try { j = pm.response.json(); } catch (_) { j = {}; } const d = j.data;",
                      "pm.test(\"Success envelope\", () => { pm.expect(j.success).to.eql(true); });",
                      "if (pm.response.code === 200) { pm.environment.set(\"aiLectureId\", d.lecture && d.lecture._id);pm.environment.set(\"generatedOutline\", JSON.stringify(d.outline));pm.environment.set(\"expectedBalance\", Number(pm.environment.get(\"fixtureBalance\"))-Number(pm.environment.get(\"outlinePrice\")));pm.test(\"Usable structured outline\", () => { pm.expect(d.outline.title).to.be.a('string').and.not.empty; pm.expect(d.outline.sections).to.be.an('array').and.not.empty; for(const section of d.outline.sections){pm.expect(section.heading).to.be.a('string').and.not.empty;pm.expect(section.bullets).to.be.an('array');for(const bullet of section.bullets)pm.expect(bullet).to.be.a('string');} });pm.test(\"Expected outline charge\", () => { pm.expect(d.creditSpent).to.eql(Number(pm.environment.get(\"outlinePrice\"))); });pm.test(\"Balance after charge\", () => { pm.expect(d.creditBalance).to.eql(Number(pm.environment.get(\"expectedBalance\"))); });pm.test(\"Lecture belongs to fixture\", () => { pm.expect(d.lecture.userId).to.eql(pm.environment.get(\"userAId\")); }); }"
                    ]
                  }
                }
              ]
            },
