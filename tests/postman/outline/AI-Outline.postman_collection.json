                      "let j; try { j = pm.response.json(); } catch (_) { j = {}; } const d = j.data;",
                      "pm.test(\"Success envelope\", () => { pm.expect(j.success).to.eql(true); });",
                      "if (pm.response.code === 200) { pm.test(\"Persisted generated outline\", () => { pm.expect(d.outline).to.eql(JSON.parse(pm.environment.get(\"generatedOutline\"))); });pm.test(\"Correct owner\", () => { pm.expect(d.userId).to.eql(pm.environment.get(\"userAId\")); }); }"
                    ]
